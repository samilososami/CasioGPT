#!/usr/bin/env python3
"""Fail when an Ollama-style token appears in publishable project files."""

from __future__ import annotations

from pathlib import Path
import re
import subprocess

ROOT = Path(__file__).resolve().parents[1]
SKIP_PARTS = {".git", ".build", ".device-backups", "device-secrets", "__pycache__"}
TOKEN_PATTERN = re.compile(rb"\b[0-9a-fA-F]{24,}\.[A-Za-z0-9_-]{12,}\b")


def candidates() -> list[Path]:
    if (ROOT / ".git").is_dir():
        result = subprocess.run(
            ["git", "ls-files", "-co", "--exclude-standard"],
            cwd=ROOT,
            check=True,
            stdout=subprocess.PIPE,
            text=True,
        )
        return [ROOT / line for line in result.stdout.splitlines() if line]
    return [
        path for path in ROOT.rglob("*")
        if path.is_file() and not any(part in SKIP_PARTS for part in path.relative_to(ROOT).parts)
    ]


failures: list[str] = []
for path in candidates():
    try:
        data = path.read_bytes()
    except OSError:
        continue
    if TOKEN_PATTERN.search(data):
        failures.append(str(path.relative_to(ROOT)))
if failures:
    raise SystemExit("ERROR: posible credencial encontrada en: " + ", ".join(sorted(set(failures))))
print("PASS secrets: no hay API keys en fuentes, documentos ni binarios.")
