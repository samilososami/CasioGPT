#!/usr/bin/env python3
"""Install CasioGPT and optionally its local Ollama Cloud API-key file."""

from __future__ import annotations

import hashlib
from importlib.machinery import SourceFileLoader
import importlib.util
import os
from pathlib import Path
import shutil
import subprocess
import time

ROOT = Path(__file__).resolve().parents[1]
DIST = ROOT / "dist"


def digest(path: Path) -> str:
    value = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(65536), b""):
            value.update(block)
    return value.hexdigest()


def load_casio_helper():
    helper_path = Path(os.environ.get("CASIO_INSTALLER", "/usr/local/bin/casio"))
    if not helper_path.is_file():
        raise RuntimeError(f"No se encuentra el instalador {helper_path}")
    loader = SourceFileLoader("casio_helper", str(helper_path))
    spec = importlib.util.spec_from_loader("casio_helper", loader)
    if not spec or not spec.loader:
        raise RuntimeError(f"No se puede cargar {helper_path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def resolve_key() -> Path | None:
    configured = os.environ.get("CASIOGPT_API_FILE")
    candidates = []
    if configured:
        candidates.append(Path(configured).expanduser())
    candidates.extend((ROOT / "casiogpt_api.txt", ROOT / "device-secrets" / "casiogpt_api.txt"))
    return next((path.resolve() for path in candidates if path.is_file()), None)


def main() -> int:
    subprocess.run([str(ROOT / "tools/build-addin")], check=True)
    sources: list[tuple[Path, str, bool]] = [(DIST / "CASIOGPT.g3a", "CASIOGPT.g3a", False)]
    key = resolve_key()
    if key:
        sources.append((key, "casiogpt_api.txt", True))

    helper = load_casio_helper()
    targets = helper.find_casio_targets()
    if len(targets) != 1:
        state = helper.casio_usb_state()
        if state == "link":
            raise RuntimeError("La Casio esta conectada, pero no en modo USB Flash")
        raise RuntimeError(f"Se esperaba una calculadora y se detectaron {len(targets)}")

    target = targets[0]
    mountpoint = None
    mounted_by_us = False
    backup_dir = ROOT / ".device-backups" / time.strftime("%Y%m%d-%H%M%S")
    try:
        mountpoint, mounted_by_us = helper.mount_target(target)
        device_root = Path(mountpoint)
        old = device_root / "CASIOGPT.g3a"
        if old.is_file():
            backup_dir.mkdir(parents=True, exist_ok=True)
            shutil.copy2(old, backup_dir / old.name)
            old.unlink()

        for source, target_name, secret in sources:
            destination = device_root / target_name
            temporary = device_root / f".{target_name}.tmp"
            shutil.copyfile(source, temporary)
            os.sync()
            if digest(source) != digest(temporary):
                raise RuntimeError(f"La verificacion de {target_name} ha fallado")
            temporary.replace(destination)
            os.sync()
            print("OK: casiogpt_api.txt instalado sin mostrar su contenido" if secret else
                  f"OK: {target_name} ({source.stat().st_size / 1_000_000:.3f} MB)")

        if not key:
            print("AVISO: falta casiogpt_api.txt; el add-in se instala, pero el chat no podra autenticarse.")
        print(f"Espacio libre restante: {shutil.disk_usage(device_root).free / 1_000_000:.2f} MB")
    finally:
        if mountpoint:
            helper.unmount_target(target, mountpoint, mounted_by_us)

    if os.geteuid() == 0 and backup_dir.exists():
        shutil.chown(backup_dir, user="kali", group="kali")
        for path in backup_dir.iterdir():
            shutil.chown(path, user="kali", group="kali")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"ERROR: {exc}", file=__import__("sys").stderr)
        raise SystemExit(1)
